# Dummy values only. Replace them with credentials for an isolated development setup.
PORT=3000
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/klettern_test
ADMIN_USER=local-admin
ADMIN_PASSWORD=replace-with-a-long-local-test-password
ADMIN_TOTP_SECRET_BASE32=replace-with-a-private-base32-secret
RUN_SCHEMA_MIGRATIONS=false
RUN_EMPLOYEE_AREAS_MIGRATION=false

# Optional services. Configure only test accounts/mailboxes for development.
BREVO_API_KEY=replace-with-test-key
BREVO_SENDER_EMAIL=test-sender@example.invalid
BOOKING_NOTIFY_EMAIL=test-inbox@example.invalid
PUBLIC_BASE_URL=https://localhost.example.invalid
BOOKING_OFFER_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=replace-with-test-secret
GPS_CODE_SECRET=replace-with-a-32-plus-character-development-secret

# Stationsprüfungen (nur mit Entwicklungs-/Testdaten nutzen)
# Geheimnis mit mindestens 32 zufälligen Zeichen; nie im Repository speichern.
STATION_CHECK_SECRET=replace-with-unique-local-random-secret-of-at-least-32-characters
# Privater ClamAV-Dienst zum Prüfen von hochgeladenen Bildern.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
# Optional: festes Postfach für Mängelmeldungen; erfordert konfigurierte Test-Mailzustellung.
PRUEF_MANGEL_EMAIL=

# One-time migration for staff and station-inspection tables only.
RUN_PRUEF_SCHEMA_MIGRATION=false

# One-time, additive Teamerbase calendar schema migration only.
RUN_TEAMERBASE_CALENDAR_MIGRATION=false
# Set the restricted read-only service account only in Render's secret environment.
TEAMERBASE_CALDAV_URL=
TEAMERBASE_CALDAV_USER=
TEAMERBASE_CALDAV_PASSWORD=
TEAMERBASE_LOCATION_FILTER=Brilon
